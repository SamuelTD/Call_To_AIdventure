OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
DB_PATH=db/sqlite/data.db
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Optional retrieval/RAG settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEY=
EMBED_MODEL=mxbai-embed-large:latest

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=call-to-aidventure

# Optional LLM resilience settings
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_PROVIDER_MAX_RETRIES=0
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_DELAY_SECONDS=0.5
LLM_RETRY_BACKOFF_MULTIPLIER=2
LLM_RETRY_MAX_DELAY_SECONDS=4
LLM_RETRY_JITTER_SECONDS=0.25
LLM_TRANSIENT_STATUS_CODES=408,409,425,429,500,502,503,504
LLM_SERVICE_UNAVAILABLE_STATUS_CODE=503
LLM_SERVICE_UNAVAILABLE_MESSAGE=The storyteller is temporarily unavailable. Your adventure is safe; please try again in a moment.
